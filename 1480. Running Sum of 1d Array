class Solution { 
    public int[] runningSum(int[] nums) { 
        int n = nums.length; 
        int result[] = new int[n]; 
        int currentSum = 0;
        
        for(int i = 0; i < n; i++){ 
            currentSum += nums[i];
            result[i] = currentSum; 
        } 
        return result; 
    } 
}
