class Solution {
    public int maximumWealth(int[][] accounts) {
        
        int current; 
        int max  = 0;
        int n = accounts.length;
        for( int i = 0;i<n;i++){
             current = 0;
            for( int j = 0;j<accounts[i].length;j++)
            {
             current +=accounts[i][j];
             
        }
        max = Math.max( current ,max);
        }

   
        return max;
        
    }
}
