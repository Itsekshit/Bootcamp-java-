class Solution {
    public int findNumbers(int[] nums) {
        int n = nums.length;
        int maxcount  = 0;
        int count  = 0;
       for( int i = 0;i<n;i++ ){
            while( nums[i] > 0 ){
                nums[i]=    nums[i] / 10 ;
                     count++;
            }
          if( count % 2 == 0){
             maxcount++;
          }
          count  = 0;
       }
    
          return  maxcount;
    }
}
